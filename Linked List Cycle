/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode(int x) : val(x), next(NULL) {}
 * };
 */
class Solution {
public:
    bool hasCycle(ListNode* head) {

        unordered_set<ListNode*> se;

        while (head != nullptr) {
            if (se.count(head)) {
                return true;
            } else {
                se.insert(head);
                head = head -> next;
            }
            /* code */
        }

        return false;
    }
};