class Solution {
public:
    void printLevelOrder(Node* root) {

        if (root == nullptr) {
            return;
        }

        queue<Node*> q;
        q.push(root);

        while (!q.empty()) {
            int len = q.size();

            Node* trace = q.front();

            for (int i = 0; i < len; i++) {

                Node* curr = q.front();
                q.pop();

                if (i == len - 1) {
                    curr->next = NULL;
                }
                if (i > 0) {
                    trace->next = curr;
                    trace = curr;
                }

                if (curr->left != nullptr) {
                    q.push(curr->left);
                }
                if (curr->right != nullptr) {
                    q.push(curr->right);
                }
            }
            /* code */
        }
    }
    Node* connect(Node* root) {
        printLevelOrder(root);
        return root;
    }
};