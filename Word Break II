class Solution {
public:
  vector<string> res;
unordered_set<string> vis;
void backtrack(string &s, vector<string> &ans, string &curr)
{
    if (s.size() == 0 && curr.size() != 0)
    {
        return;
    }

    if (s.size() == 0 && curr.size() == 0)
    {
        string temp = "";
        for (string &x : ans)
        {
            temp.append(x + " ");
        }
        temp.pop_back();
        res.push_back(temp);
        return;
    }

    char last = s.back();
    s.pop_back();
    string new_curr = "";
    curr.push_back(last);

    if (vis.count(curr))
    {
        ans.push_back(curr);
        backtrack(s, ans, new_curr);
        ans.pop_back();
    }

    backtrack(s, ans, curr);
    s.push_back(last);
    curr.pop_back();
}
    vector<string> wordBreak(string s, vector<string>& wordDict) {
        for (string x : wordDict)
    {
        vis.insert(x);
    }

    reverse(s.begin(), s.end());
    vector<string> ans;
    string curr = "";
    backtrack(s, ans, curr);

    return res;
    }
};