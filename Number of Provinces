class Solution {
public:
    int vis[200];

    void dfs(int curr, vector<vector<int>>& g) {
        vis[curr] = 1;

        for (int x : g[curr]) {
            if (!vis[x]) {
                dfs(x, g);
            }
        }
    }

    int findCircleNum(vector<vector<int>>& isConnected) {

        int m = isConnected[0].size();
        int n = isConnected.size();

        vector<vector<int>> g(n + 1);

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < m; j++) {
                if (isConnected[i][j] == 1 && i != j) {
                    g[i].push_back(j);
                    g[j].push_back(i);
                }
            }
        }
        int res = 0;
        for (int i = 0; i < n; i++) {
            if (!vis[i]) {
                res++;
                dfs(i, g);
            }
        }

        return res;
    }
};