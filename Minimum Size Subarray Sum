class Solution
{
public:
    int minSubArrayLen(int target, vector<int> &nums)
    {

        int minimal = INT_MAX;
        int len = nums.size();

        int left = 0, right = 0;
        int sum = 0;

        while (right < len)
        {

            while (sum < target && right < len)
            {
                sum += nums[right];
                // cout<<sum<<" ";
                right++;
            }

            if (sum >= target)
            {
                minimal = min(minimal, right - left);
            }

            while (sum >= target && left < right)
            {
                sum -= nums[left];
                left++;
                if (sum >= target)
                {
                    minimal = min(minimal, right - left);
                }
            }
        }
        return (minimal == INT_MAX ? 0 : minimal);
    }
};