using namespace std;

int C(int n, int k){
    
    if( k == 0 || k == n ) return 1;
    if( k == 1 || k == n - 1 ) return n;

    int res = 1;
    for( int i = 0; i < k; i++ )
    {
        res *= (n - i);
        res /= (i + 1);
    }
    return res;
}

