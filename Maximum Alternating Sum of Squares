class Solution {
public:
    long long maxAlternatingSum(vector<int>& nums) {

        int len = nums.size();

        for(int &x : nums){
            x = abs(x);
        }

        sort(nums.begin(), nums.end());

        long long res = 0;

        int n = len/2;

        for( int i = 0 ; i < n ; i ++){
            res -= nums[i] * nums[i];
        }
        for( int i = n ; i < len ; i++){
            res += nums[i] * nums[i];
        }

        return res;
        
    }
};