class Solution {
public:
    int res = 0;

    void backtrack(vector<int>& nums, int index, int curr, int target) {

        if (index == nums.size()) {
            if (curr == target) {
                res++;
            }
            return;
        }

        backtrack(nums, index + 1, curr + nums[index], target);
        backtrack(nums, index + 1, curr - nums[index], target);
    }
    int findTargetSumWays(vector<int>& nums, int target) {

        backtrack(nums, 0, 0, target);
        return res;
    }
};