class Solution {
public:
    string multiply(string num1, string num2) {
        int n1 = num1.size();
    int n2 = num2.size();

    vector<int> v(n1 + n2, 0);
    int carry = 0;

    for( int i = n1 - 1; i >= 0; i-- )
    {
        for( int j = n2 - 1; j >= 0; j-- )
        {
            int p1 = i + j;
            int p2 = i + j + 1;
            int mul = (num1[i] - '0') * (num2[j] - '0') + carry;
            carry = mul / 10;
            mul = mul % 10;
            v[p2] = v[p2] + mul;
            if( v[p2] >= 10 ){
                v[p1] += v[p2] / 10;
                v[p2] = v[p2] % 10;
            }
            v[p1] += carry;
            carry = 0;
        }
    }
    int start = 0;
    string res = "";
    while( start < v.size() && v[start] == 0 ) start++;
    if( start == v.size() ) res = "0";
    else
    {
        for( int i = start; i < v.size(); i++ )
        {
            res += to_string(v[i]);
        }
    }
    return res;
    }
};