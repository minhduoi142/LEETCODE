class Solution {
public:

    string removeOuterParentheses(string s) {
        stack<char> st;

        int len = s.size();
        string res = "";
        string curr = "";

        for( int i = 0 ; i < len ; i++){
            if(s[i] == '('){
                st.push(s[i]);
                curr.push_back(s[i]);
            }
            else{
                if(!st.empty()){
                    st.pop();
                    curr.push_back(s[i]);

                    if(st.empty()){
                        curr.pop_back();
                        curr.erase(0, 1);
                        res += curr;
                        curr = "";
                    }
                }
            }
        }
        // res += curr;
        return res;
    }
};