class Solution {
public:
    bool canFinish(int numCourses, vector<vector<int>>& prerequisites) {
        int inDeg[2001] = {0};
        vector<vector<int>> g(numCourses);
        for (vector<int>& ve : prerequisites) {
            g[ve[1]].push_back(ve[0]);
            inDeg[ve[0]]++;
        }
        queue<int> q;
        for (int i = 0; i < numCourses; i++) {
            if (inDeg[i] == 0) {
                q.push(i);
                // cout<<i<<" "<<inDeg[i]<<endl;
            }
        }
        int topoCount = 0;
        while (!q.empty()) {
            int curr = q.front();
            q.pop();
            topoCount++;
            for (int x : g[curr]) {
                inDeg[x]--;
                if (inDeg[x] == 0) {
                    q.push(x);
                }
            }
        }
        if (topoCount == numCourses) {
            return true;
        }
        return false;
    }
};
