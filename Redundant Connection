class Solution {
public:
    int parent[1005] = {0};

    int find(int u) {
        if (parent[u] == u) {
            return u;
        } else {
            return parent[u] = find(parent[u]);
        }
    }

    bool Union(int u, int v) {

        int rootU = find(u);
        int rootV = find(v);

        if (rootU == rootV) {
            return false;
        } else {
            parent[rootU] = rootV;
            return true;
        }
    }
    vector<int> findRedundantConnection(vector<vector<int>>& edges) {
        for( int i = 0; i < 1005; i ++){
            parent[i] = i;
        }
        for (vector<int> ve : edges) {
            if (!Union(ve[0], ve[1])) {
                return {ve[0], ve[1]};
            }
        }
        return {};
    }
};