class Solution {
public:
    vector<int> loudAndRich(vector<vector<int>>& richer, vector<int>& quiet) {
        int n = quiet.size();
        vector<vector<int>> g(n);
        vector<int> res(n, 0);
        vector<int> inDeg(n, 0);

        for (vector<int>& ve : richer) {
            g[ve[0]].push_back(ve[1]);
            inDeg[ve[1]]++;
        }

        queue<int> q;

        for (int i = 0; i < n; i++) {
            res[i] = i;
            if (inDeg[i] == 0) {
                q.push(i);
            }
        }

        while (!q.empty()) {

            int curr = q.front();
            q.pop();

            for (int x : g[curr]) {
                inDeg[x]--;
                if (quiet[res[x]] >= quiet[res[curr]]) {
                    res[x] = res[curr];
                }

                if (inDeg[x] == 0) {
                    q.push(x);
                }
            }
        }

        return res;
    }
};