class Solution {
public:
    vector<int> loudAndRich(vector<vector<int>>& richer, vector<int>& quiet) {
        int n = quiet.size();
        vector<vector<int>> g(n);
        vector<int> res(n, 0);
        vector<unordered_set<int>> vs(n);
        vector<int> inDeg(n, 0);

        for (vector<int>& ve : richer) {
            g[ve[0]].push_back(ve[1]);
            inDeg[ve[1]]++;
        }

        queue<int> q;

        for (int i = 0; i < n; i++) {
            vs[i].insert(i);
            if (inDeg[i] == 0) {
                q.push(i);
            }
        }

        while (!q.empty()) {

            int curr = q.front();
            q.pop();

            for (int x : g[curr]) {
                inDeg[x]--;
                for (int i : vs[curr]) {
                    vs[x].insert(i);
                }

                if (inDeg[x] == 0) {

                    q.push(x);
                }
            }
        }

        for (int i = 0; i < n; i++) {
            int min = 1000;
            int curr = -1;

            for (int x : vs[i]) {
                if (min > quiet[x]) {
                    min = quiet[x];
                    curr = x;
                }
            }

            res[i] = curr;
        }

        return res;
    }
};