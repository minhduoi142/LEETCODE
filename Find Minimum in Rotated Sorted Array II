class Solution {
public:
    int findMin(vector<int>& nums) {
        int len = nums.size();

        int l = 0;
        int r = len - 1;

        while (l < r) {

            int mid = (l + r) / 2;

            if (nums[l] == nums[mid] && nums[mid] == nums[r]) {
                l++;
                r--;
                continue;
            }

            if (nums[mid] > nums[r]) {
                l = mid + 1;
            } else {
                r = mid;
            }

            /* code */
        }
        return nums[l];
    }
};