class Solution {
public:
    vector<int> findMinHeightTrees(int n, vector<vector<int>>& edges) {

        if (n == 1) {
            return {0};
        }
        vector<vector<int>> g(n + 1);
        vector<int> deg(n + 1, 0);
        queue<int> q;

        for (vector<int> ve : edges) {
            g[ve[0]].push_back(ve[1]);
            g[ve[1]].push_back(ve[0]);
            deg[ve[0]]++;
            deg[ve[1]]++;
        }

        for (int i = 0; i < n; i++) {
            if (deg[i] == 1) {
                q.push(i);
            }
        }

        int remain = n;

        while (remain > 2) {
            int leaf = q.size();
            remain -= leaf;

            for (int i = 0; i < leaf; i++) {
                int curr = q.front();
                q.pop();

                for (int x : g[curr]) {
                    deg[x]--;
                    if (deg[x] == 1) {
                        q.push(x);
                    }
                }
            }
        }
        vector<int> res;
        while (!q.empty()) {
            res.push_back(q.front());
            q.pop();
        }
        return res;
    }
};