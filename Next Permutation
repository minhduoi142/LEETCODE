class Solution {
public:
    void nextPermutation(vector<int>& nums) {
        int len = nums.size();

    // next permutation
    if (next_permutation(nums.begin(), nums.end()))
    {
        for (int i = 0; i < len; i++)
        {
            cout << nums[i] << " ";
        }
    }
    else
    {
        for( int i = len - 1; i >= 0; i--)
        {
            cout << nums[i] << " ";
        }
    }

    }
};