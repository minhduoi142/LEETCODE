class Solution {
public:

int res = 0;

void backtrack(int index, string curr, int n, vector<int> &vis)
{
    if (index >= n)
    {
        return;
    }

    res++;
    // cout << curr << endl;

    for (int i = 0; i <= 9; i++)
    {
        if (index == 0)
        {
            if(i == 0 && !curr.size()){
                continue;
            }
        }
        if (vis[i] == 0)
        {
            if (curr.size() == 0)
            {
                vis[i] = 1;
                backtrack(index, curr + char('0' + i), n, vis);
                vis[i] = 0;
            }
            else
            {
                vis[i] = 1;
                backtrack(index + 1, curr + char('0' + i), n, vis);
                vis[i] = 0;
            }
        }
    }
}
    int countNumbersWithUniqueDigits(int n) {
        if(n == 0){
            return 1;
        }
                vector<int> vis(10, 0);
    string curr = "";


    backtrack(0, curr, n, vis);
    return res;
    }
};