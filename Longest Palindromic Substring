class Solution {
public:
    string longestPalindrome(string s) {
        int len = s.length();

    int maxLen = 0;
    string ans = "";

    for (int i = 0; i < len; i++)
    {

        int last = i;
        int start = i;
        int ok = 0;

        while (s[last] == s[last + 1])
        {
            last++;
            ok = 1;
        }
        while (start > 0 && last < len - 1 && s[start - 1] == s[last + 1])
        {
            start--;
            last++;
        }
        if (maxLen < last - start + 1)
        {
            maxLen = last - start + 1;
            ans = "";

            for (int j = start; j <= last; j++)
            {
                ans += s[j];
            }
        }
    }

    return ans;
    }
};